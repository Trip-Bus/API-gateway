# =============================================================================
#  Entorno QA LOCAL de la plataforma completa (valores de la convención, NO son secretos reales).
#  Uso:  cp .env.qa.example .env.qa   y luego   scripts/qa.ps1 up   (o scripts/qa.sh up)
#  El .env.qa no se sube a git.
# =============================================================================

# Perfil de Spring de todos los servicios (activa además el perfil "desplegado").
SPRING_PROFILE=qa

# --- Dónde está el código de cada servicio (se compila con docker build) --------------------
# Por defecto, los 8 repos clonados uno al lado del otro:  <carpeta>/API-gateway, <carpeta>/identity, ...
# Si tu estructura es otra, cambia las rutas (relativas a esta carpeta o absolutas).
IDENTITY_SRC=../identity
CATALOG_SRC=../catalog-service
SEAT_INVENTORY_SRC=../seat-inventory-service
BOOKING_SRC=../booking-payment-service
FLEET_SRC=../fleet-trip-events-service
FLASH_OFFERS_SRC=../flash-offerts-service
REALTIME_SRC=../Realtime-Gateway

# --- PostgreSQL: una por servicio (usuario/contraseña de cada .env.example) ------------------
IDENTITY_DB_USERNAME=identity
IDENTITY_DB_PASSWORD=identity_qa_pw
CATALOG_DB_USERNAME=catalog
CATALOG_DB_PASSWORD=catalog_qa_pw
INVENTORY_DB_USERNAME=inventory
INVENTORY_DB_PASSWORD=inventory_qa_pw
BOOKING_DB_USERNAME=booking
BOOKING_DB_PASSWORD=booking_qa_pw
FLEET_DB_USERNAME=fleet
FLEET_DB_PASSWORD=fleet_qa_pw
OFFERS_DB_USERNAME=offers
OFFERS_DB_PASSWORD=offers_qa_pw

# --- Redis compartido, con contraseña ---------------------------------------------------------
REDIS_PASSWORD=tripbus_redis_qa_pw

# --- Secretos entre servicios ----------------------------------------------------------------
INTERNAL_API_TOKEN=tripbus_internal_qa_token
TICKET_SECRET=tripbus_ticket_qa_secret
PAYMENT_WEBHOOK_SECRET=tripbus_webhook_qa_secret

# --- Datos de demostración --------------------------------------------------------------------
# Usuarios admin@, operador@, conductor@, pasajero@tripbus.co (solo con el perfil qa).
DEMO_USERS_PASSWORD=TripBus2026
SEED_ON_STARTUP=true
SIMULATOR_ENABLED=true

# --- Correo del tiquete (US-033) --------------------------------------------------------------
# No hace falta configurar nada: docker-compose.qa.yml pone MAIL_HOST=mailpit y MAIL_PORT=1025, y los
# correos se ven en http://localhost:18025 (Mailpit, sin usuario ni contraseña).
# Opcional: cambiar el remitente (por defecto "TripBus <no-reply@tripbus.co>").
# MAIL_FROM=TripBus <no-reply@tripbus.co>

# --- Navegador ---------------------------------------------------------------------------------
# Frontend en Vite (5173) y la página de demo del Realtime Gateway (18007), que llama al API.
CORS_ALLOWED_ORIGIN=http://localhost:5173,http://localhost:18007
WS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:18007
PUBLIC_API_URL=http://localhost:18000

# Descomenta para levantar también Prometheus (http://localhost:9090).
# COMPOSE_PROFILES=observability
