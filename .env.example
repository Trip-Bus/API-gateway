# Copia este archivo como .env y cambia los secretos antes de desplegar en un servidor.
DB_USERNAME=tripbus
DB_PASSWORD=cambia-esta-clave
INTERNAL_API_TOKEN=cambia-este-token-interno
PAYMENT_WEBHOOK_SECRET=cambia-este-secreto-de-webhook
TICKET_SECRET=cambia-este-secreto-de-tiquetes

# Usuarios de demostración (admin, operador, conductor, pasajero @tripbus.co)
DEMO_USERS_ENABLED=true
DEMO_USERS_PASSWORD=TripBus2026

# Simulador GPS del MVP
SIMULATOR_ENABLED=true

# CORS / URLs públicas (en un servidor: el dominio o IP pública)
CORS_ALLOWED_ORIGIN=*
WS_ALLOWED_ORIGINS=*
PUBLIC_API_URL=http://localhost:8080

# Puertos publicados en la máquina
GATEWAY_PORT=8080
REALTIME_PORT=16007
POSTGRES_PORT=5432
REDIS_PORT=6379

# Imágenes del CI (docker compose pull)
REGISTRY=ghcr.io/trip-bus
TAG=latest
