# =============================================================================
#  TripBus — API Gateway (NGINX)
#  Punto de entrada único (puerto 18000) para el REST y el WebSocket: enrutamiento, autenticación
#  de borde (JWT validado con identity vía auth_request), rate limiting global, CORS y logging.
#  NO tiene lógica de negocio. El WebSocket del Realtime Gateway entra por /ws y se reenvía tal cual
#  (el JWT del handshake lo valida el propio Realtime Gateway).
#  Sirve además el frontend (/ → contenedor frontend, HT-03), la documentación unificada (/docs, HT-13)
#  y el API versionado (/api/v1/... y /api/... → la ruta de siempre, HT-07).
#  Las variables ${...} se reemplazan al iniciar el contenedor (envsubst).
# =============================================================================

# ---- Correlación: se respeta el X-Request-Id del cliente si es corto y seguro (mismo patrón que
#      el RequestIdFilter de los servicios); si no viene o no es válido, NGINX genera uno.
map $http_x_request_id $req_id {
    "~^[A-Za-z0-9._-]{1,64}$" $http_x_request_id;
    default                   $request_id;
}

# ---- CORS: el map lo genera 25-cors-origins.sh a partir de CORS_ALLOWED_ORIGIN (lista con comas).
map $http_origin $cors_allow_origin {
    include /etc/nginx/cors-origins.map;
}

log_format tripbus_json escape=json
  '{"time":"$time_iso8601","request_id":"$req_id","ip":"$remote_addr",'
  '"method":"$request_method","uri":"$request_uri","status":$status,'
  '"bytes":$body_bytes_sent,"duration":$request_time,"user":"$auth_user_id",'
  '"upstream":"$upstream_addr","upstream_time":"$upstream_response_time"}';

# Igual que tripbus_json pero con $uri (sin query string): el frontend manda ?token=JWT en el
# handshake del WebSocket y el token no debe quedar en los logs.
log_format tripbus_ws_json escape=json
  '{"time":"$time_iso8601","request_id":"$req_id","ip":"$remote_addr",'
  '"method":"$request_method","uri":"$uri","status":$status,'
  '"bytes":$body_bytes_sent,"duration":$request_time,"user":"$auth_user_id",'
  '"upstream":"$upstream_addr","upstream_time":"$upstream_response_time"}';

# ---- Encabezados de seguridad (HT-12) ----------------------------------------------
# CSP del frontend: todo del mismo origen (scripts, estilos, fuentes autoalojadas) más Google Fonts.
# 'unsafe-inline' solo en estilos: sonner y vaul insertan <style> y la página de banco de prueba
# (/sandbox/) trae su CSS en línea. connect-src: el API y el WebSocket del mismo origen (ws/wss).
# form-action: 'self'; en /sandbox/ además FRONTEND_URL, porque el formulario del banco de prueba
# redirige (302) al frontend y Chrome aplica form-action también a esa redirección.
map $uri $csp_form_action {
    ~^/sandbox/ "'self' ${FRONTEND_URL}";
    default     "'self'";
}
# HSTS solo con HSTS_ENABLED=true (detrás del túnel con HTTPS). Un add_header vacío no se envía.
map "${HSTS_ENABLED}" $hsts_header {
    true    "max-age=31536000; includeSubDomains";
    default "";
}
# /docs (HT-13): en PROD solo con DOCS_ENABLED=true.
map "${DOCS_ENABLED}" $docs_enabled {
    true    1;
    default 0;
}
# Spec de cada servicio: /docs/specs/<servicio> → /v3/api-docs del upstream de ese servicio.
map $uri $docs_spec_upstream {
    /docs/specs/identity       identity;
    /docs/specs/catalog        catalog;
    /docs/specs/seat-inventory seat_inventory;
    /docs/specs/booking        booking;
    /docs/specs/fleet          fleet;
    /docs/specs/flash-offers   flash_offers;
    /docs/specs/realtime       realtime;
    default                    "";
}

# ---- WebSocket: "Connection: upgrade" solo si el cliente pidió el upgrade -----------
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# ---- Rate limiting global: por IP y por usuario (token) -------------------------
limit_req_zone $binary_remote_addr zone=per_ip:10m   rate=${RATE_LIMIT_PER_IP};
limit_req_zone $http_authorization zone=per_user:10m rate=${RATE_LIMIT_PER_USER};
limit_req_zone $binary_remote_addr zone=auth_ip:10m  rate=${RATE_LIMIT_AUTH};
limit_req_status 429;
# Conexiones WebSocket abiertas a la vez por IP (cada una cuenta mientras siga abierta).
limit_conn_zone $binary_remote_addr zone=ws_conn_ip:10m;
limit_conn_status 429;

# ---- Resolución DNS dinámica ------------------------------------------------------
# Sin esto NGINX resuelve los nombres UNA vez al arrancar: si un contenedor se reinicia con otra IP
# el gateway responde 502 hasta reiniciarlo. Con "zone" + "resolve" (NGINX >= 1.27.3) vuelve a
# preguntar al DNS (Docker: 127.0.0.11) cada "valid" segundos y sigue también las réplicas nuevas.
resolver ${RESOLVER};
resolver_timeout 3s;

upstream identity       { zone up_identity 64k;       server ${IDENTITY_UPSTREAM} resolve;       keepalive 16; }
upstream catalog        { zone up_catalog 64k;        server ${CATALOG_UPSTREAM} resolve;        keepalive 16; }
upstream seat_inventory { zone up_seat_inventory 64k; server ${SEAT_INVENTORY_UPSTREAM} resolve; keepalive 32; }
upstream booking        { zone up_booking 64k;        server ${BOOKING_UPSTREAM} resolve;        keepalive 16; }
upstream fleet          { zone up_fleet 64k;          server ${FLEET_UPSTREAM} resolve;          keepalive 16; }
upstream flash_offers   { zone up_flash_offers 64k;   server ${FLASH_OFFERS_UPSTREAM} resolve;   keepalive 32; }
# Sin keepalive: cada WebSocket es una conexión propia ("Connection: upgrade"), no se reutiliza.
upstream realtime       { zone up_realtime 64k;       server ${REALTIME_UPSTREAM} resolve; }
# Frontend (SPA servida por su propio NGINX) y Swagger UI de /docs.
upstream frontend       { zone up_frontend 64k;       server ${FRONTEND_UPSTREAM} resolve;       keepalive 16; }
upstream swagger_ui     { zone up_swagger_ui 64k;     server ${SWAGGER_UI_UPSTREAM} resolve;     keepalive 4; }

server {
    listen ${GATEWAY_PORT};
    server_name _;

    access_log /dev/stdout tripbus_json;
    client_max_body_size 1m;
    server_tokens off;

    # ---- IP real del cliente detrás del túnel de Cloudflare (HT-04) ------------------
    # cloudflared se conecta desde la red de Docker y manda la IP del visitante en CF-Connecting-IP.
    # Solo se cree ese header si la conexión viene de REAL_IP_FROM (por defecto 172.16.0.0/12, las redes
    # de Docker); así los límites por IP (rate limit, conexiones de /ws) cuentan a cada visitante y no
    # a cloudflared. Las conexiones directas desde Internet llegan con su IP pública y no se tocan.
    set_real_ip_from ${REAL_IP_FROM};
    real_ip_header   CF-Connecting-IP;

    # ---- CORS para el frontend (solo a los orígenes de CORS_ALLOWED_ORIGIN) --------
    add_header Access-Control-Allow-Origin   $cors_allow_origin always;
    add_header Access-Control-Allow-Methods  "GET, POST, PUT, PATCH, DELETE, OPTIONS" always;
    add_header Access-Control-Allow-Headers  "Authorization, Content-Type, Idempotency-Key, X-Request-Id" always;
    add_header Access-Control-Expose-Headers "X-Request-Id, Idempotent-Replayed, Retry-After, X-Total-Count" always;
    add_header Access-Control-Max-Age        600 always;
    add_header Vary                          Origin always;
    add_header X-Request-Id                  $req_id always;
    # HT-12: en TODAS las respuestas (frontend, API y /docs).
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' ws://$http_host wss://$http_host; manifest-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action $csp_form_action" always;
    add_header X-Content-Type-Options  "nosniff" always;
    add_header Referrer-Policy         "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options         "DENY" always;
    # El conductor comparte su ubicación desde la app: la geolocalización solo para el mismo origen.
    add_header Permissions-Policy      "geolocation=(self)" always;
    add_header Strict-Transport-Security $hsts_header always;
    if ($request_method = OPTIONS) {
        return 204;
    }
    # Vacío salvo en las rutas que entran por /api/ (ver "API versionado").
    set $api_prefijo "";

    # Límite general por IP (cada location puede definir uno más estricto).
    limit_req zone=per_ip burst=60 nodelay;

    # ---- Proxy común ---------------------------------------------------------------
    proxy_http_version 1.1;
    proxy_set_header Connection        "";
    proxy_set_header Host              $host;
    proxy_set_header X-Request-Id      $req_id;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-User-Id         $auth_user_id;
    proxy_set_header X-User-Role       $auth_user_role;
    # Los servicios devuelven el mismo X-Request-Id: se oculta para no duplicar el header del gateway.
    proxy_hide_header X-Request-Id;
    proxy_connect_timeout 2s;
    proxy_read_timeout    30s;
    proxy_next_upstream   error timeout http_502 http_503;

    # ---- Autenticación de borde: el JWT se valida con identity ---------------------
    auth_request_set $auth_user_id   $upstream_http_x_user_id;
    auth_request_set $auth_user_role $upstream_http_x_user_role;

    # Subpetición interna: va directo al upstream (no pasa por "location = /auth/validate").
    location = /_auth {
        internal;
        proxy_pass http://identity/auth/validate;
        proxy_pass_request_body off;
        proxy_set_header Connection     "";
        proxy_set_header Content-Length "";
        proxy_set_header Authorization  $http_authorization;
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header X-Request-Id   $req_id;
    }

    # Ojo: una location que declara su propio error_page (p. ej. el 418 de las rutas con GET público) NO
    # hereda estos; por eso esas locations los repiten.
    error_page 401 = @unauthorized;
    error_page 403 = @forbidden;
    error_page 429 = @too_many_requests;
    error_page 502 503 504 = @unavailable;

    location @unauthorized {
        default_type application/json;
        return 401 '{"error":{"code":"UNAUTHENTICATED","message":"Se requiere un token de acceso válido","details":{}}}';
    }
    # Un 403 generado por NGINX solo puede venir de auth_request: identity responde 403 en /auth/validate
    # únicamente cuando el rol exige la verificación en dos pasos y aún no está activa (US-106,
    # MFA_REQUIRED_ROLES). Los 403 de los servicios pasan tal cual (proxy_intercept_errors está apagado).
    location @forbidden {
        default_type application/json;
        return 403 '{"error":{"code":"MFA_SETUP_REQUIRED","message":"Tu rol exige la verificación en dos pasos: actívala en /users/me/2fa antes de continuar","details":{}}}';
    }
    location @too_many_requests {
        default_type application/json;
        add_header Retry-After 1 always;
        add_header Access-Control-Allow-Origin $cors_allow_origin always;
        add_header X-Request-Id $req_id always;
        return 429 '{"error":{"code":"RATE_LIMITED","message":"Demasiadas solicitudes, intenta de nuevo en un momento","details":{}}}';
    }
    location @unavailable {
        default_type application/json;
        return 503 '{"error":{"code":"SERVICE_UNAVAILABLE","message":"El servicio no está disponible en este momento","details":{}}}';
    }

    # ======================= API versionado (HT-07) ==================================
    # /api/v1/<ruta> y /api/<ruta> se reescriben a /<ruta> (la de siempre) y vuelven a buscar location:
    # pasan por la MISMA autenticación y los MISMOS límites (limit_req cuenta una vez por petición).
    # $api_prefijo queda en 1 para que una ruta desconocida bajo /api/ responda 404 JSON y no el frontend.
    location ^~ /api/ {
        set $api_prefijo 1;
        rewrite ^/api/v1(/.*)$ $1 last;
        rewrite ^/api(/.*)$    $1 last;
    }

    # ======================= Identity ===============================================
    location = /auth/register { limit_req zone=auth_ip burst=10 nodelay; proxy_pass http://identity; }
    location = /auth/login    { limit_req zone=auth_ip burst=10 nodelay; proxy_pass http://identity; }
    location = /auth/refresh   { limit_req zone=auth_ip burst=10 nodelay; proxy_pass http://identity; }
    # Segundo paso del login con 2FA (US-106): público, con el límite estricto de login.
    location = /auth/2fa      { limit_req zone=auth_ip burst=10 nodelay; proxy_pass http://identity; }
    location = /auth/verify-email { limit_req zone=auth_ip burst=10 nodelay; proxy_pass http://identity; }
    location = /auth/verify-email/resend { auth_request /_auth; proxy_pass http://identity; }
    location /auth/password-reset/ { limit_req zone=auth_ip burst=5 nodelay; proxy_pass http://identity; }
    # Solo para uso interno del gateway (location /_auth): desde fuera no existe.
    location = /auth/validate {
        default_type application/json;
        return 404 '{"error":{"code":"NOT_FOUND","message":"Ruta no encontrada en el API Gateway","details":{}}}';
    }
    # Sin auth_request: identity valida el JWT y permite cerrar sesión aunque falte activar la 2FA obligatoria
    # (con auth_request, /auth/validate respondería 403 MFA_SETUP_REQUIRED y no se podría salir).
    location = /auth/logout   { proxy_pass http://identity; }
    # = /users: listado (GET) y alta de usuarios por el ADMIN (POST).
    location = /users         { auth_request /_auth; proxy_pass http://identity; }
    location /users/          { auth_request /_auth; proxy_pass http://identity; }
    # Activar la 2FA (US-106): sin auth_request por la misma razón; identity exige el JWT y solo deja pasar
    # /users/me/2fa/* mientras la verificación obligatoria no esté activa.
    location /users/me/2fa/   { proxy_pass http://identity; }
    location = /.well-known/jwks.json { proxy_pass http://identity; }
    # Auditoría de acciones administrativas (US-105). Regex: gana a "location /admin/" de Catalog.
    location ~ ^/admin/audit  { auth_request /_auth; proxy_pass http://identity; }

    # ======================= Fleet + Trip Events ====================================
    # (regex: tienen prioridad sobre los prefijos /trips/, /itineraries/ y /buses/ de Catalog)
    # Recorrido y puntualidad de un viaje terminado (US-182): público, como bus-position.
    location ~ ^/itineraries/[^/]+/track$         { proxy_pass http://fleet; }
    # Reporte de puntualidad (US-193): es de Fleet aunque el resto de /reports/ sea de Booking.
    location ~ ^/reports/punctuality              { auth_request /_auth; proxy_pass http://fleet; }
    # Compartir mi viaje (US-181): crear el enlace exige token; abrirlo (/share/{codigo}) es público.
    location /share-links                         { auth_request /_auth; proxy_pass http://fleet; }
    location /share/                              { proxy_pass http://fleet; }
    location ~ ^/trips/[^/]+/timeline$            { proxy_pass http://fleet; }
    location ~ ^/trips/[^/]+/events$              { auth_request /_auth; proxy_pass http://fleet; }
    # Asignación de conductores (PUT/GET /trips/{id}/driver, DELETE /trips/{id}/driver/{rol}).
    location ~ ^/trips/[^/]+/driver(/.*)?$        { auth_request /_auth; proxy_pass http://fleet; }
    # Inicio/fin y alertas del viaje para el operador (US-171, US-176).
    location ~ ^/trips/[^/]+/(finish|alerts)(/.*)?$ { auth_request /_auth; proxy_pass http://fleet; }
    location ~ ^/itineraries/[^/]+/bus-position$  { proxy_pass http://fleet; }
    # Hora estimada por parada (US-180): pública, como bus-position.
    location ~ ^/itineraries/[^/]+/eta$           { proxy_pass http://fleet; }
    # Manifiesto de pasajeros (US-172): es de Booking, no de Catalog.
    location ~ ^/itineraries/[^/]+/manifest$      { auth_request /_auth; proxy_pass http://booking; }
    # Alertas de la empresa (US-176).
    location = /alerts  { auth_request /_auth; proxy_pass http://fleet; }
    location /alerts/   { auth_request /_auth; proxy_pass http://fleet; }
    # Temporal (se retiran en el Sprint 5): /buses/{id}/position y /telemetry/; el resto de /buses/ es de Catalog.
    location ~ ^/buses/[^/]+/position$            { proxy_pass http://fleet; }
    location /telemetry/ {
        auth_request /_auth;
        limit_req zone=per_user burst=100 nodelay;
        proxy_pass http://fleet;
    }
    # App del conductor: mis viajes, rastreo y ubicación. El celular envía cada 5–10 s y el lote puede
    # llegar de golpe al recuperar señal: mismo límite por usuario que /telemetry/.
    location /driver/ { auth_request /_auth; proxy_pass http://fleet; }
    location = /driver/location {
        auth_request /_auth;
        limit_req zone=per_user burst=100 nodelay;
        proxy_pass http://fleet;
    }
    location = /driver/location/batch {
        auth_request /_auth;
        limit_req zone=per_user burst=100 nodelay;
        proxy_pass http://fleet;
    }
    # SOS (US-176): nunca debe recibir 429 por el límite de /driver/location; solo el límite general.
    location = /driver/sos { auth_request /_auth; proxy_pass http://fleet; }

    # ======================= Catalog ================================================
    location /trips/       { proxy_pass http://catalog; }
    location /admin/       { auth_request /_auth; proxy_pass http://catalog; }
    location /operator/    { auth_request /_auth; proxy_pass http://catalog; }
    # Empresas y buses: todo exige token (el rol lo valida Catalog).
    location = /companies  { auth_request /_auth; proxy_pass http://catalog; }
    location /companies/   { auth_request /_auth; proxy_pass http://catalog; }
    location = /buses      { auth_request /_auth; proxy_pass http://catalog; }
    location /buses/       { auth_request /_auth; proxy_pass http://catalog; }
    # Rutas: GET público (p. ej. /routes/{id}/stops, que usan fleet y el frontend); el resto exige token.
    location = /routes {
        error_page 418 = @catalog_public;
        error_page 401 = @unauthorized;
        error_page 403 = @forbidden;
        error_page 429 = @too_many_requests;
        error_page 502 503 504 = @unavailable;
        if ($request_method = GET) { return 418; }
        auth_request /_auth;
        proxy_pass http://catalog;
    }
    location /routes/ {
        error_page 418 = @catalog_public;
        error_page 401 = @unauthorized;
        error_page 403 = @forbidden;
        error_page 429 = @too_many_requests;
        error_page 502 503 504 = @unavailable;
        if ($request_method = GET) { return 418; }
        auth_request /_auth;
        proxy_pass http://catalog;
    }
    # Viajes: el listado del operador exige token; detalle, seatmap y precio (GET) son públicos;
    # programar (/itineraries/schedule) y cancelar exigen token.
    location = /itineraries { auth_request /_auth; proxy_pass http://catalog; }
    location /itineraries/ {
        error_page 418 = @catalog_public;
        error_page 401 = @unauthorized;
        error_page 403 = @forbidden;
        error_page 429 = @too_many_requests;
        error_page 502 503 504 = @unavailable;
        if ($request_method = GET) { return 418; }
        auth_request /_auth;
        proxy_pass http://catalog;
    }
    # Terminales (US-115): GET público; crear, editar y borrar exigen token (ADMIN).
    location = /terminals {
        error_page 418 = @catalog_public;
        error_page 401 = @unauthorized;
        error_page 403 = @forbidden;
        error_page 429 = @too_many_requests;
        error_page 502 503 504 = @unavailable;
        if ($request_method = GET) { return 418; }
        auth_request /_auth;
        proxy_pass http://catalog;
    }
    location /terminals/ {
        error_page 418 = @catalog_public;
        error_page 401 = @unauthorized;
        error_page 403 = @forbidden;
        error_page 429 = @too_many_requests;
        error_page 502 503 504 = @unavailable;
        if ($request_method = GET) { return 418; }
        auth_request /_auth;
        proxy_pass http://catalog;
    }
    # Autocompletado de ciudades y terminales (US-115): público.
    location = /places { proxy_pass http://catalog; }
    # Tarifas (US-138, US-141): /fares/seasons, /fares/passenger-types, /fares/seat-surcharges. Todo con token.
    location /fares/   { auth_request /_auth; proxy_pass http://catalog; }
    location @catalog_public { proxy_pass http://catalog; }

    # ======================= Seat Inventory =========================================
    # GET (ver mapa/disponibilidad) es público; retener/extender/liberar exige token.
    location /seats/ {
        error_page 418 = @seats_public;
        error_page 401 = @unauthorized;
        error_page 403 = @forbidden;
        error_page 429 = @too_many_requests;
        error_page 502 503 504 = @unavailable;
        if ($request_method = GET) { return 418; }
        auth_request /_auth;
        limit_req zone=per_user burst=20 nodelay;
        proxy_pass http://seat_inventory;
    }
    # Operaciones privadas aunque sean GET; van antes de la regla pública general.
    location ~ ^/seats/itineraries/[^/]+/(occupancy|waitlist)$ {
        auth_request /_auth;
        limit_req zone=per_user burst=20 nodelay;
        proxy_pass http://seat_inventory;
    }
    location /seats/waitlist/ {
        auth_request /_auth;
        limit_req zone=per_user burst=20 nodelay;
        proxy_pass http://seat_inventory;
    }
    location @seats_public { proxy_pass http://seat_inventory; }

    # ======================= Booking + Payment ======================================
    location /bookings { auth_request /_auth; proxy_pass http://booking; }
    # Comprobantes PDF (US-146): con token aunque el resto de GET /payments/ sea público.
    location ~ ^/payments/[^/]+/receipt\.pdf$ { auth_request /_auth; proxy_pass http://booking; }
    location /refunds/ { auth_request /_auth; proxy_pass http://booking; }
    # Cupones (US-147).
    location = /coupons { auth_request /_auth; proxy_pass http://booking; }
    location /coupons/  { auth_request /_auth; proxy_pass http://booking; }
    location /tickets/ { auth_request /_auth; proxy_pass http://booking; }
    location /box-office/ { auth_request /_auth; proxy_pass http://booking; }
    location /reports/ { auth_request /_auth; proxy_pass http://booking; }
    location /payments/ {
        error_page 418 = @booking_public;
        error_page 401 = @unauthorized;
        error_page 403 = @forbidden;
        error_page 429 = @too_many_requests;
        error_page 502 503 504 = @unavailable;
        if ($request_method = GET) { return 418; }
        auth_request /_auth;
        proxy_pass http://booking;
    }
    location /sandbox/ { proxy_pass http://booking; }
    location @booking_public { proxy_pass http://booking; }
    # Webhook de la pasarela: se autentica con su firma HMAC, no con JWT.
    location = /webhooks/payment { proxy_pass http://booking; }

    # ======================= Flash Offers ===========================================
    location /operator/offers { auth_request /_auth; proxy_pass http://flash_offers; }
    # Ofertas automáticas (US-167) y recurrentes (US-169): prefijos más específicos que /operator/ de Catalog.
    location /operator/auto-offer-rules { auth_request /_auth; proxy_pass http://flash_offers; }
    location /operator/offer-templates  { auth_request /_auth; proxy_pass http://flash_offers; }
    # Sala de espera (US-162): entrar y consultar mi turno exigen token en todos los métodos (también GET).
    location ~ ^/offers/[^/]+/queue(/.*)?$ {
        auth_request /_auth;
        limit_req zone=per_user burst=20 nodelay;
        proxy_pass http://flash_offers;
    }
    location /offers/follows { auth_request /_auth; proxy_pass http://flash_offers; }
    location ~ ^/offers/[^/]+/metrics$ { auth_request /_auth; proxy_pass http://flash_offers; }
    location /offers {
        error_page 418 = @offers_public;
        error_page 401 = @unauthorized;
        error_page 403 = @forbidden;
        error_page 429 = @too_many_requests;
        error_page 502 503 504 = @unavailable;
        if ($request_method = GET) { return 418; }
        auth_request /_auth;
        limit_req zone=per_user burst=20 nodelay;
        proxy_pass http://flash_offers;
    }
    location @offers_public { proxy_pass http://flash_offers; }

    # ======================= Fleet ===================================================
    location /fleet/ { auth_request /_auth; proxy_pass http://fleet; }

    # ======================= Realtime Gateway (REST) ================================
    # Notificaciones push (US-185): la llave pública VAPID es pública; suscribirse y borrar, con token.
    location = /push/public-key { proxy_pass http://realtime; }
    location /push/             { auth_request /_auth; proxy_pass http://realtime; }

    # ======================= Realtime Gateway (WebSocket) ===========================
    # ws(s)://<gateway>:18000/ws. Sin auth_request: el Realtime Gateway valida el JWT del handshake
    # y responde 401/403 si no es válido; NGINX solo limita y reenvía (con la query string).
    location = /ws {
        # Handshakes por IP (más estricto que el general) y conexiones abiertas por IP.
        limit_req  zone=per_ip burst=10 nodelay;
        limit_conn ws_conn_ip 20;

        # Sin la query string (?token=JWT) en los logs: access log con $uri; los rechazos por límite
        # se registran en "info" y el error log de esta location solo en "crit", porque NGINX copia la
        # línea de petición completa (con el token) en sus mensajes de error. El access log sigue
        # mostrando el status y el upstream de cada handshake.
        access_log /dev/stdout tripbus_ws_json;
        error_log  /dev/stderr crit;
        limit_req_log_level  info;
        limit_conn_log_level info;
        # Errores propios: los del server (@too_many_requests, @unavailable) loguean con $request_uri.
        error_page 429 = @ws_too_many_requests;
        error_page 502 503 504 = @ws_unavailable;

        proxy_pass http://realtime;
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_set_header Host              $host;
        proxy_set_header X-Request-Id      $req_id;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Al definir proxy_set_header aquí no se heredan los del server: se vacían a mano para que el
        # cliente no pueda inyectar una identidad.
        proxy_set_header X-User-Id         "";
        proxy_set_header X-User-Role       "";
        # El servidor envía ping cada 20 s: 75 s tolera perder un par sin cortar la conexión.
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
        proxy_buffering    off;
    }
    location @ws_too_many_requests {
        access_log /dev/stdout tripbus_ws_json;
        error_log  /dev/stderr crit;
        default_type application/json;
        add_header Retry-After 1 always;
        add_header Access-Control-Allow-Origin $cors_allow_origin always;
        add_header X-Request-Id $req_id always;
        return 429 '{"error":{"code":"RATE_LIMITED","message":"Demasiadas solicitudes, intenta de nuevo en un momento","details":{}}}';
    }
    location @ws_unavailable {
        access_log /dev/stdout tripbus_ws_json;
        error_log  /dev/stderr crit;
        default_type application/json;
        return 503 '{"error":{"code":"SERVICE_UNAVAILABLE","message":"El servicio no está disponible en este momento","details":{}}}';
    }

    # ======================= Nunca expuestos ========================================
    # ^~: ninguna regex puede ganarle (catalog expone /internal/companies/{id} solo para identity).
    location ^~ /internal/ {
        default_type application/json;
        return 404 '{"error":{"code":"NOT_FOUND","message":"Ruta no encontrada en el API Gateway","details":{}}}';
    }
    location /actuator/ {
        default_type application/json;
        return 404 '{"error":{"code":"NOT_FOUND","message":"Ruta no encontrada en el API Gateway","details":{}}}';
    }

    location = /health {
        access_log off;
        default_type application/json;
        return 200 '{"status":"UP"}';
    }

    # ======================= Documentación unificada (HT-13) =========================
    # Swagger UI (contenedor swagger-ui, BASE_URL=/docs) con un selector por servicio. Cada spec sale de
    # /v3/api-docs del servicio; los servicios declaran OPENAPI_SERVER_URL=/api/v1 para que "Try it out"
    # pase por este gateway. En PROD solo con DOCS_ENABLED=true (y el springdoc del servicio encendido).
    location = /docs { return 301 /docs/; }
    location ^~ /docs/specs/ {
        default_type application/json;
        if ($docs_enabled = 0) {
            return 404 '{"error":{"code":"NOT_FOUND","message":"Ruta no encontrada en el API Gateway","details":{}}}';
        }
        if ($docs_spec_upstream = "") {
            return 404 '{"error":{"code":"NOT_FOUND","message":"Servicio sin documentación en el API Gateway","details":{}}}';
        }
        proxy_pass http://$docs_spec_upstream/v3/api-docs;
    }
    location ^~ /docs/ {
        default_type application/json;
        if ($docs_enabled = 0) {
            return 404 '{"error":{"code":"NOT_FOUND","message":"Ruta no encontrada en el API Gateway","details":{}}}';
        }
        proxy_pass http://swagger_ui;
    }

    # ======================= Frontend (HT-03) ========================================
    # Todo lo demás es la app: el NGINX del contenedor frontend devuelve index.html para cualquier ruta
    # de la SPA. Una ruta desconocida bajo /api/ (reescrita arriba) responde 404 JSON, no la app.
    location / {
        default_type application/json;
        if ($api_prefijo) {
            return 404 '{"error":{"code":"NOT_FOUND","message":"Ruta no encontrada en el API Gateway","details":{}}}';
        }
        proxy_pass http://frontend;
        # El frontend ya manda sus propios encabezados de seguridad: se usan los del gateway (sin duplicar).
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header Permissions-Policy;
    }
}
