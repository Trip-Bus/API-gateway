# =============================================================================
#  Entorno PROD (servidor). PLANTILLA: solo marcadores, nunca pongas aquí secretos reales.
#  Uso en el servidor:  cp .env.prod.example .env.prod  && nano .env.prod  && chmod 600 .env.prod
#  Cambia CADA valor CAMBIAR_*. Si falta una variable, docker compose no arranca y dice cuál.
#  Genera cada secreto con:   openssl rand -base64 32      (uno distinto por variable)
#  Para usuarios de BD basta un nombre simple sin espacios (p. ej. el de QA).
# =============================================================================

SPRING_PROFILE=prod

# Tag de las imágenes de GHCR (prod = último push a main; también sirve sha-<corto> para fijar una versión).
TAG=prod

# --- PostgreSQL: una por servicio --------------------------------------------------------------
IDENTITY_DB_USERNAME=identity
IDENTITY_DB_PASSWORD=CAMBIAR_ESTE_SECRETO        # openssl rand -base64 32
CATALOG_DB_USERNAME=catalog
CATALOG_DB_PASSWORD=CAMBIAR_ESTE_SECRETO         # openssl rand -base64 32
INVENTORY_DB_USERNAME=inventory
INVENTORY_DB_PASSWORD=CAMBIAR_ESTE_SECRETO       # openssl rand -base64 32
BOOKING_DB_USERNAME=booking
BOOKING_DB_PASSWORD=CAMBIAR_ESTE_SECRETO         # openssl rand -base64 32
FLEET_DB_USERNAME=fleet
FLEET_DB_PASSWORD=CAMBIAR_ESTE_SECRETO           # openssl rand -base64 32
OFFERS_DB_USERNAME=offers
OFFERS_DB_PASSWORD=CAMBIAR_ESTE_SECRETO          # openssl rand -base64 32

# --- Redis --------------------------------------------------------------------------------------
# Solo letras y números (va en la línea de comandos de redis-server):  openssl rand -hex 32
REDIS_PASSWORD=CAMBIAR_ESTE_SECRETO

# --- Secretos entre servicios ---------------------------------------------------------------------
INTERNAL_API_TOKEN=CAMBIAR_ESTE_SECRETO          # openssl rand -base64 32
TICKET_SECRET=CAMBIAR_ESTE_SECRETO               # openssl rand -base64 32
PAYMENT_WEBHOOK_SECRET=CAMBIAR_ESTE_SECRETO      # openssl rand -base64 32

# --- Datos ----------------------------------------------------------------------------------------
# true solo si quieres sembrar el catálogo de demostración (idempotente). Simulador GPS apagado.
SEED_ON_STARTUP=false
SIMULATOR_ENABLED=false

# --- Navegador: el dominio público (sin '*') ------------------------------------------------------
CORS_ALLOWED_ORIGIN=https://CAMBIAR-DOMINIO.example
WS_ALLOWED_ORIGINS=https://CAMBIAR-DOMINIO.example
# URL pública del API Gateway (la usa la página de demo del Realtime Gateway).
PUBLIC_API_URL=https://CAMBIAR-DOMINIO.example:18000
