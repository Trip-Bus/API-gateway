# =============================================================================
#  Entorno PROD (servidor). PLANTILLA: solo marcadores, nunca pongas aquí secretos reales.
#  Uso en el servidor:  cp .env.prod.example .env.prod  && nano .env.prod  && chmod 600 .env.prod
#  Cambia CADA valor CAMBIAR_*. Si falta una variable, docker compose no arranca y dice cuál.
#  Genera cada secreto con:   openssl rand -base64 32      (uno distinto por variable)
#  Para usuarios de BD basta un nombre simple sin espacios (p. ej. el de QA).
# =============================================================================

SPRING_PROFILE=prod

# Tag de las imágenes de GHCR (prod = último push a main; también sirve sha-<corto> para fijar una versión).
TAG=prod
# El CI del frontend publica main, develop, latest y sha-<corto> (no "prod"): main = la rama de PROD.
FRONTEND_TAG=main

# --- PostgreSQL: una por servicio --------------------------------------------------------------
IDENTITY_DB_USERNAME=identity
IDENTITY_DB_PASSWORD=CAMBIAR_ESTE_SECRETO        # openssl rand -base64 32
CATALOG_DB_USERNAME=catalog
CATALOG_DB_PASSWORD=CAMBIAR_ESTE_SECRETO         # openssl rand -base64 32
INVENTORY_DB_USERNAME=inventory
INVENTORY_DB_PASSWORD=CAMBIAR_ESTE_SECRETO       # openssl rand -base64 32
BOOKING_DB_USERNAME=booking
BOOKING_DB_PASSWORD=CAMBIAR_ESTE_SECRETO         # openssl rand -base64 32
FLEET_DB_USERNAME=fleet
FLEET_DB_PASSWORD=CAMBIAR_ESTE_SECRETO           # openssl rand -base64 32
OFFERS_DB_USERNAME=offers
OFFERS_DB_PASSWORD=CAMBIAR_ESTE_SECRETO          # openssl rand -base64 32

# --- Redis --------------------------------------------------------------------------------------
# Solo letras y números (va en la línea de comandos de redis-server):  openssl rand -hex 32
REDIS_PASSWORD=CAMBIAR_ESTE_SECRETO

# --- Secretos entre servicios ---------------------------------------------------------------------
INTERNAL_API_TOKEN=CAMBIAR_ESTE_SECRETO          # openssl rand -base64 32
TICKET_SECRET=CAMBIAR_ESTE_SECRETO               # openssl rand -base64 32
PAYMENT_WEBHOOK_SECRET=CAMBIAR_ESTE_SECRETO      # openssl rand -base64 32

# --- Datos ----------------------------------------------------------------------------------------
# true solo si quieres sembrar el catálogo de demostración (idempotente). Simulador GPS apagado.
SEED_ON_STARTUP=false
SIMULATOR_ENABLED=false

# --- Correo del tiquete (US-033): OPCIONAL ---------------------------------------------------------
# Vacío = no se envían correos (el servicio arranca igual). Para activarlo, pon aquí el SMTP del
# proveedor que se elija; con usuario se usa AUTH + STARTTLS (normalmente el puerto 587).
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# --- Login con Google (opcional) ------------------------------------------------------------------
# Client ID web de Google Cloud (es público). Vacío = desactivado (POST /auth/google responde 404).
GOOGLE_CLIENT_ID=

# --- Navegador: el dominio público (sin '*') ------------------------------------------------------
CORS_ALLOWED_ORIGIN=https://CAMBIAR-DOMINIO.example
WS_ALLOWED_ORIGINS=https://CAMBIAR-DOMINIO.example
# URL pública del API Gateway (la usa la página de demo del Realtime Gateway).
PUBLIC_API_URL=https://CAMBIAR-DOMINIO.example:18000

# URL pública del frontend. Obligatoria para enlaces de verificación y navegación.
FRONTEND_URL=https://CAMBIAR_FRONTEND_URL.example

# --- Notificaciones push del Realtime Gateway (US-185): OBLIGATORIAS en PROD ------------------------
# Genera el par una sola vez (si cambia, los navegadores suscritos dejan de recibir avisos):
#   docker run --rm node:22-alpine npx -y web-push generate-vapid-keys
VAPID_PUBLIC_KEY=CAMBIAR_LLAVE_PUBLICA_VAPID
VAPID_PRIVATE_KEY=CAMBIAR_LLAVE_PRIVADA_VAPID
VAPID_SUBJECT=mailto:CAMBIAR-CORREO@example.com

# --- Túnel de Cloudflare (HT-04) --------------------------------------------------------------------
# Con token: túnel con nombre de tu cuenta de Cloudflare (enlace fijo en tu dominio; en el panel de Zero
# Trust apúntalo a http://api-gateway:18000). Vacío: túnel rápido https://<aleatorio>.trycloudflare.com
# (cambia en cada reinicio; scripts/tunnel-url.sh lo muestra). Con el túnel rápido agrega el patrón
# https://*.trycloudflare.com a WS_ALLOWED_ORIGINS (el Realtime acepta patrones).
CLOUDFLARE_TUNNEL_TOKEN=
# true solo si el público entra por HTTPS (túnel con dominio): agrega Strict-Transport-Security.
HSTS_ENABLED=false

# --- Documentación /docs (HT-13) --------------------------------------------------------------------
# Apagada en PROD. true la publica en /docs (los servicios en perfil prod también apagan springdoc).
DOCS_ENABLED=false

# --- Copias de seguridad (HT-05) --------------------------------------------------------------------
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=7

# --- Observabilidad (HT-10): COMPOSE_PROFILES=observabilidad para encenderla --------------------------
# COMPOSE_PROFILES=observabilidad
GRAFANA_ADMIN_PASSWORD=CAMBIAR_ESTE_SECRETO     # openssl rand -base64 24
TRACING_SAMPLING=0.1

# --- Verificación en dos pasos de identity (US-106) -------------------------------------------------
# Si cambia, las 2FA ya activadas dejan de funcionar (hay que volver a configurarlas).
MFA_ENCRYPTION_KEY=CAMBIAR_ESTE_SECRETO          # openssl rand -base64 32
# Roles obligados a activar la 2FA (vacío = nadie). Ej.: ADMIN o ADMIN,OPERADOR
MFA_REQUIRED_ROLES=
