# =============================================================================
#  Despliegue distribuido en 2 máquinas por Tailscale (escenario de calidad 1.1).
#  Copia este archivo como .env.distribuido en LAS DOS máquinas (mismo contenido) y úsalo junto a .env.prod:
#    docker compose -f docker-compose.nodo-b.yml --env-file .env.prod --env-file .env.distribuido up -d
#    docker compose -f docker-compose.nodo-a.yml --env-file .env.prod --env-file .env.distribuido up -d --build
#  Guía: docs/despliegue-distribuido.md. Los secretos siguen en .env.prod (no se repiten aquí).
# =============================================================================

# IP de Tailscale de cada máquina (tailscale ip -4). Valores de ejemplo: reemplázalos.
NODO_A_IP=100.64.0.1
NODO_B_IP=100.64.0.2

# Interfaz en la que se publican los puertos internos (bases, Redis, réplicas, OTLP, servicios del nodo A).
# Vacío = 0.0.0.0 (todas): entonces el firewall de Windows debe limitarlos a la red de Tailscale
# (100.64.0.0/10). Para escuchar solo en Tailscale pon aquí la IP de Tailscale de ESE nodo.
NODO_A_BIND_IP=
NODO_B_BIND_IP=

# Variables nuevas del API Gateway (NGINX). El compose del nodo A ya las fija a partir de NODO_B_IP:
#   CATALOG_UPSTREAM_2=${NODO_B_IP}:18002
#   SEAT_INVENTORY_UPSTREAM_2=${NODO_B_IP}:18003
# En los despliegues de un solo nodo quedan vacías (un único servidor por upstream, como siempre).
